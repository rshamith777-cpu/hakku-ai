# Required in production: 64+ char random hex string (generate with: openssl rand -hex 32)
SESSION_SECRET=your_cryptographically_secure_random_64char_hex_here

# Allowed CORS origins (comma-separated). Defaults to https://hakku-ai.netlify.app and localhost
HAKKU_ALLOWED_ORIGINS=https://hakku-ai.netlify.app

# Optional BharatCode Model API Configuration
BHARATCODE_API_KEY=your_bharatcode_api_key_here
BHARATCODE_BASE_URL=https://api.bharatcode.ai/v1
BHARATCODE_MODEL=qwen-3.8-27b

PORT=3000


